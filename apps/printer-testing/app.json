{
  "expo": {
    "name": "IndyzAI Printer Testing",
    "slug": "indyzai-pos-printer-testing",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "indyzai-pos-printer-testing",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Allow IndyzAI to discover and print to nearby Bluetooth label and receipt printers.",
        "NSLocalNetworkUsageDescription": "Allow IndyzAI to send receipts and labels to printers on your local network."
      },
      "bundleIdentifier": "com.indyzai.pos.print.setup",
      "supportsTablet": true
    },
    "android": {
      "package": "com.indyzai.pos.print.setup",
      "adaptiveIcon": {
        "backgroundColor": "#B9C9FA",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow IndyzAI Printer Testing to use Face ID to unlock your POS session."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
